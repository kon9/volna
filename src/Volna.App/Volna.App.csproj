<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Volna</AssemblyName>
    <RootNamespace>Volna.App</RootNamespace>
    <ApplicationIcon>..\..\assets\generated\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' != 'win-arm64'">true</VlcWindowsX64Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">false</VlcWindowsX64Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">true</VlcWindowsArm64Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' != 'win-arm64'">false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\lucide.ttf" />
    <AvaloniaResource Include="..\..\assets\generated\icon-256.png" Link="Assets\icon-256.png" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <ProjectReference Include="..\Volna.Core\Volna.Core.csproj" />
  </ItemGroup>
  <!-- VLC discovers plugins by directory. Keep its runtime beside the executable even in single-file builds. -->
  <Target Name="KeepVlcRuntimeOutsideBundle" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
